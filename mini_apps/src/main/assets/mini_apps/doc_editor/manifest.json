{
  "name": "Piloos Doc",
  "description": "Read and edit Word (.docx) files on your phone or computer: headings, lists, fonts and sizes, tables, pictures, shapes, equations, columns, section breaks, headers and footers, page numbers, comments and footnotes, track changes, and page view. Opens files straight from other apps, keeps a draft of your edits, and works offline.",
  "category": "Productivity",
  "version": "2.0.3",
  "updatedAt": "2026-10-29",
  "icon": "icon.png",
  "showInApp": true,
  "workflowSuggestions": [
    {
      "title": "Soạn thảo Word",
      "prompt": "Mở Piloos Doc và giúp tôi mở một file Word."
    }
  ],
  "entry": "index.html",
  "permissions": [
    "storage_write"
  ],
  "accepts": [
    {
      "type": "document",
      "multiple": false,
      "maxItems": 1,
      "mimeTypes": [
        "application/vnd.openxmlformats-officedocument.wordprocessingml.document"
      ]
    }
  ],
  "tags": [
    "word",
    "docx",
    "documents",
    "editor",
    "reader",
    "office",
    "offline"
  ],
  "relatedFolders": [],
  "architecture": "{\"appName\": \"Piloos Doc\", \"navType\": \"router\", \"pages\": [\"home\", \"doc\"], \"dataModels\": [\"docs\", \"prefs\"]}",
  "mcp": {
    "groups": {
      "core": "Always listed: read, search, insert/replace text, tables basics.",
      "format": "Character and paragraph formatting, links.",
      "table": "Rows, columns, merge, shade, move tables.",
      "layout": "Blocks order, breaks, contents, pictures, header/footer, page setup.",
      "review": "Comments, replies, track changes, undo and redo, saving a draft.",
      "picture": "Resize, align, rotate or delete pictures.",
      "list": "Bullet and numbering styles, restart and continue numbering.",
      "notes": "Footnotes and bookmarks."
    },
    "tools": [
      {
        "name": "doc_read_outline",
        "group": "core",
        "description": "List blocks (index, type, first 120 chars). Call first; default 40 blocks, page with from/to.",
        "inputSchema": {
          "type": "object",
          "properties": {
            "from": {
              "type": "integer",
              "minimum": 0
            },
            "to": {
              "type": "integer",
              "minimum": 0
            }
          },
          "required": []
        },
        "readOnly": true
      },
      {
        "name": "doc_read_block",
        "group": "core",
        "description": "Full text of a block, or all cell texts of a table.",
        "inputSchema": {
          "type": "object",
          "properties": {
            "index": {
              "type": "integer",
              "minimum": 0
            }
          },
          "required": [
            "index"
          ]
        },
        "readOnly": true
      },
      {
        "name": "doc_new_document",
        "group": "core",
        "description": "Open a new empty Word document for editing. Call this first when doc_get_info shows no document is open, or any edit says document_not_open_for_editing.",
        "inputSchema": {
          "type": "object",
          "properties": {},
          "required": []
        }
      },
      {
